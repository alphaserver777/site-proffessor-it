---
import Base from '../../../layouts/Base.astro';
---
<Base title="Проверка оплаты — Профессор IT" description="Подтверждение оплаты тест-драйва IT-профессии">
  <main class="payment-result shell">
    <section class="payment-result-card" data-payment-result>
      <span class="success-mark" data-result-mark>…</span>
      <p class="kicker">PRODAMUS / ПРОВЕРКА ПЛАТЕЖА</p>
      <h1 data-result-title>Проверяем оплату</h1>
      <p data-result-copy>Обычно подтверждение занимает несколько секунд. Не закрывайте страницу.</p>
      <a class="button primary large" href="/" hidden data-result-home>Вернуться на главную</a>
      <div class="payment-result-links" hidden data-result-contacts>
        <a href="https://t.me/proffessor_it">Написать в Telegram</a>
        <a href="https://max.ru/u/f9LHodD0cOKSwTkPJdylbGaluZM4miWZqbpMcBD7uTVI8UGfJLvPabOTi08">Написать в MAX</a>
      </div>
    </section>
  </main>
  <script>
    const token=new URLSearchParams(location.search).get('enrollment');
    const title=document.querySelector<HTMLElement>('[data-result-title]')!;const copy=document.querySelector<HTMLElement>('[data-result-copy]')!;const mark=document.querySelector<HTMLElement>('[data-result-mark]')!;const home=document.querySelector<HTMLElement>('[data-result-home]')!;const contacts=document.querySelector<HTMLElement>('[data-result-contacts]')!;
    let attempts=0;const check=async()=>{if(!token){title.textContent='Не найден номер заявки';copy.textContent='Напишите нам — мы проверим платёж вручную.';contacts.hidden=false;return;}try{const response=await fetch(`/api/public/test-drive/${encodeURIComponent(token)}`);const result=await response.json();if(response.ok&&result.status!=='awaiting_payment'){mark.textContent='✓';title.textContent='Оплата подтверждена';copy.textContent='Участие в тест-драйве оформлено. Я получил уведомление и свяжусь с вами для выдачи задания.';home.hidden=false;contacts.hidden=false;return;}}catch{}attempts+=1;if(attempts<15)setTimeout(check,2000);else{title.textContent='Платёж обрабатывается';copy.textContent='Подтверждение задержалось. Сохраните эту страницу или напишите мне — платёж не потеряется.';contacts.hidden=false;}};check();
  </script>
</Base>
