---
import Base from '../layouts/Base.astro';
import Brief from '../components/Brief.astro';
import {faq, personas, roadmap} from '../data/site';
const title = 'Профессор IT — индивидуальное наставничество DevOps и ИБ';
const description = 'Персональный инженерный маршрут: лабораторная практика, обратная связь и проекты по DevOps, информационной безопасности и этичному пентесту.';
const jsonLd = {'@context':'https://schema.org','@graph':[{'@type':'Person',name:'Вадим Моисеенко',jobTitle:'Инженерный наставник, кандидат технических наук',url:'https://professorit.ru/'},{'@type':'Service',name:'Тест-драйв инженерного наставничества',provider:{'@type':'Person',name:'Вадим Моисеенко'},areaServed:'RU',offers:{'@type':'Offer',price:'1500',priceCurrency:'RUB'}},{'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
---
<Base {title} {description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Профессор IT — главная"><span class="brand-mark">P</span><span>ПРОФЕССОР IT<small>ENGINEERING MENTORSHIP</small></span></a>
    <nav aria-label="Основная навигация"><a href="#characters">Персонажи</a><a href="#test-drive">Тест-драйв</a><a href="#method">Маршрут</a><a href="#mentor">Наставник</a></nav>
    <button class="button compact" data-open-brief>Начать за 1 500 ₽</button>
  </header>
  <main id="top">
    <section class="hero shell">
      <div class="hero-copy reveal"><div class="eyebrow"><span></span> ИНДИВИДУАЛЬНЫЙ ИНЖЕНЕРНЫЙ ТРЕК</div><h1>Ваш индивидуальный<br/>маршрут <em>в IT</em></h1><p class="hero-lead">Персональная программа, лабораторная практика и разбор решений под руководством кандидата технических наук.</p><div class="hero-actions"><button class="button primary large" data-open-brief>Пройти тест-драйв <b>1 500 ₽</b></button><a class="text-link" href="#characters">Выбрать персонажа <span>↓</span></a></div><div class="hero-proof"><span><b>1:1</b> Обратная связь</span><span><b>2 дня</b> Мини-квест</span><span><b>30 мин</b> Личный разбор</span></div></div>
      <div class="hero-system hero-engine reveal" aria-label="Инженерное ядро персонального маршрута">
        <div class="engine-grid"></div><div class="engine-glow"></div>
        <div class="engine-top"><span><i></i> МАРШРУТ / ПЕРСОНАЛЬНЫЙ</span><b>PROFESSOR IT · 1:1</b></div>
        <svg class="engine-circuit" viewBox="0 0 620 620" aria-hidden="true"><circle cx="310" cy="300" r="178"/><circle class="engine-orbit" cx="310" cy="300" r="135"/><path d="M52 150h96l45 46M428 405l45 48h96M106 487h96l35-39M412 166l39-38h116"/><path class="engine-energy" d="M52 150h96l45 46C225 228 227 165 310 165c75 0 135 60 135 135s-60 135-135 135c-55 0-102-33-123-80M428 405l45 48h96"/></svg>
        <div class="engine-input"><small>ВАША ТОЧКА СТАРТА</small><strong>Цель · опыт · темп</strong><span>Система учитывает ваши знания и доступное время</span></div>
        <div class="engine-core"><div class="engine-core-ring"></div><span>ИНЖЕНЕРНОЕ ЯДРО</span><strong>Персональный<br/>маршрут</strong><small>ПРАКТИКА × РЕВЬЮ × ПРОЕКТ</small></div>
        <div class="engine-class engine-class-devops"><span class="engine-class-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M11 8c-5 0-8 3-8 8s3 8 8 8c6 0 9-8 10-11 1-3 3-5 6-5 2 0 4 2 4 4s-2 4-4 4c-3 0-5-2-7-5C17 7 15 8 11 8Z"/><path d="M17 21c3 2 5 3 8 3 4 0 7-2 8-6"/></svg></span><span>DevOps</span></div>
        <div class="engine-class engine-class-security"><span class="engine-class-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 3 27 7v8c0 7-4 11-11 14C9 26 5 22 5 15V7Z"/><path d="M11 15h10v8H11Zm2 0v-3a3 3 0 0 1 6 0v3"/></svg></span><span>ИБ</span></div>
        <div class="engine-class engine-class-hacker"><span class="engine-class-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="5"/><path d="M16 1v7m0 16v7M1 16h7m16 0h7"/></svg></span><span>Пентест</span></div>
        <div class="engine-output"><small>ПРОФЕССИОНАЛЬНЫЙ РЕЗУЛЬТАТ</small><strong>Навык, который<br/>можно доказать</strong><div><span>Знания</span><span>Проект</span><span>Цель: оффер</span></div></div>
        <div class="engine-stages"><span><b>01</b> Диагностика</span><span><b>02</b> Практика</span><span><b>03</b> Ревью</span><span><b>04</b> Защита</span></div>
      </div>
    </section>
    <section class="contrast section shell reveal"><div class="section-head contrast-heading"><span class="kicker">КУРС ИЛИ НАСТАВНИЧЕСТВО</span><h2>Купить курс легко<br/><em>Стать специалистом — сложнее</em></h2><p>Записанные уроки дают информацию, но не замечают момент, когда вы перестали понимать, закрепили ошибку или взяли задачу не по уровню. Именно здесь многие сходят с дистанции. В индивидуальном треке вы не остаётесь с проблемой один на один.</p></div><div class="contrast-grid"><article class="muted-card course-card"><div class="comparison-label"><span class="card-code">МАССОВЫЙ ВИДЕОКУРС</span><b>01</b></div><h3>Доступ к урокам<br/>Дальше — самостоятельно</h3><div class="video-player" aria-hidden="true"><span>▶</span><div><i></i><i></i><i></i></div><small>Урок 14 из 126</small></div><div class="course-progress" aria-label="Типичный путь самостоятельного курса"><span class="watched">Мотивация</span><i></i><span>Видео</span><i></i><span class="drop">Первая сложность</span><i class="broken"></i><span class="drop">Пауза</span></div><ul><li><strong>Одинаковая программа</strong> для людей с разным опытом и целью</li><li><strong>Некому увидеть ошибку</strong> в вашем решении и объяснить её причину</li><li><strong>Следующий урок уже открыт</strong>, даже если предыдущий навык не закреплён</li></ul><div class="comparison-outcome weak"><span>Типичный итог</span><b>«Я всё посмотрел, но самостоятельно сделать пока не могу»</b></div></article><div class="versus"><span>точка<br/>выбора</span></div><article class="active-card mentorship-card"><div class="comparison-label"><span class="card-code">ПРОФЕССОР IT / LIVE</span><b>02</b></div><h3>Маршрут, практика<br/>и наставник рядом</h3><div class="mentor-loop"><span>Задача</span><b>→</b><span>Практика</span><b>→</b><span>Разбор</span><b>↻</b></div><ul><li><strong>Маршрут строим от вашей точки</strong>, цели и реальных пробелов</li><li><strong>Сложность заданий меняется</strong> вместе с вашим прогрессом</li><li><strong>Каждую ошибку превращаем в понимание</strong>, а понимание — в рабочий навык</li></ul><div class="comparison-outcome strong"><span>Результат трека</span><b>«Я сделал это сам и могу объяснить каждое решение»</b></div></article></div><div class="contrast-conclusion"><span>КУРС ОСТАВЛЯЕТ ВАС С КОНТЕНТОМ</span><i>→</i><strong>ИНДИВИДУАЛЬНЫЙ ТРЕК ВЕДЁТ К САМОСТОЯТЕЛЬНОМУ РЕЗУЛЬТАТУ</strong></div><p class="contrast-verdict">Разница не в количестве уроков. <strong>Разница — дойдёте ли вы до навыка.</strong></p></section>
    <section class="roadmap-section section shell reveal" id="method"><div class="section-head split"><div><span class="kicker">КАК УСТРОЕН ОСНОВНОЙ ТРЕК</span><h2>Маршрут от диагностики<br/>до защиты проекта</h2></div><p>Каждый этап превращает знания в самостоятельный навык. Выберите точку маршрута и посмотрите, что происходит внутри и с каким результатом вы двигаетесь дальше.</p></div><div class="journey-map"><div class="journey-track"><svg class="journey-line" viewBox="0 0 1200 330" preserveAspectRatio="none" aria-hidden="true"><path d="M70 220 C175 55 300 55 410 220 S640 385 760 145 S1000 15 1130 190"/><path class="journey-pulse" d="M70 220 C175 55 300 55 410 220 S640 385 760 145 S1000 15 1130 190"/></svg>{roadmap.map((item,index)=><button class={`journey-stop ${index===0?'active':''}`} type="button" data-roadmap-step={index} aria-pressed={index===0?'true':'false'}><span>{item.number}</span><i>{index===0?'⌖':index===1?'◈':index===2?'⬡':index===3?'⚙':index===4?'◆':'★'}</i><strong>{item.title}</strong><small>{item.short}</small></button>)}</div><article class="journey-detail" data-roadmap-detail><div class="journey-detail-index"><span>{roadmap[0].number}</span><small>ЭТАП МАРШРУТА</small></div><div class="journey-detail-copy"><h3>{roadmap[0].title}</h3><p>{roadmap[0].text}</p></div><div class="journey-detail-result"><small>РЕЗУЛЬТАТ ЭТАПА</small><strong>{roadmap[0].result}</strong></div></article><script is:inline type="application/json" data-roadmap-data set:html={JSON.stringify(roadmap)} /></div></section>
    <section class="characters section" id="characters"><div class="shell"><div class="section-head centered reveal"><span class="kicker">ВЫБЕРИТЕ СВОЕГО ПЕРСОНАЖА</span><h2>Одна инженерная база<br/>Три профессиональных пути</h2><p>Если вы начинаете с нуля — сначала проходите общий фундамент: Linux, сети, Git, автоматизация и безопасная лаборатория.</p></div><div class="origin-node reveal"><span>00</span><div><small>ОБЩИЙ КЛАСС</small><strong>Новичок</strong></div><p>Понимать систему → диагностировать → автоматизировать</p></div><div class="branch-lines" aria-hidden="true"><span></span><span></span><span></span></div><div class="persona-grid">{personas.map((item)=><article class="persona-card reveal" data-persona-card={item.id} style={`--accent:${item.color};--glow:${item.glow}`}><div class="persona-top"><span class="persona-number">КЛАСС {item.number}</span><span class="class-emblem" aria-hidden="true">{item.id==='devops'?<svg viewBox="0 0 100 100"><path d="M50 8 85 28v44L50 92 15 72V28Z"/><path d="M30 62V39l20-12 20 12v23L50 74Z"/><path d="M50 27v47M30 39l20 12 20-12"/></svg>:item.id==='security'?<svg viewBox="0 0 100 100"><path d="M50 8 84 21v28c0 22-14 35-34 43-20-8-34-21-34-43V21Z"/><path d="M36 49V39a14 14 0 0 1 28 0v10M30 49h40v27H30Z"/><path d="M50 58v9"/></svg>:<svg viewBox="0 0 100 100"><path d="M50 9 82 31l-6 45-26 15-26-15-6-45Z"/><path d="M23 34c10 2 18-2 27-12 9 10 17 14 27 12M29 43l11 7 10-5 10 5 11-7M30 45l4 25 16 11 16-11 4-25"/><path d="m36 58 8 3m20-3-8 3M43 70h14"/><circle cx="41" cy="60" r="2"/><circle cx="59" cy="60" r="2"/></svg>}</span></div><small>{item.eyebrow}</small><h3>{item.name}</h3><p class="persona-lead">{item.lead}</p><div class="persona-detail"><b>Подойдёт</b><p>{item.fit}</p><b>Ключевые навыки</b><div class="tags">{item.skills.map((skill)=><span>{skill}</span>)}</div><b>Мини-квест</b><p>{item.quest}</p><b>Артефакт</b><p>{item.artifact}</p></div><button class="button persona-button" data-select-persona={item.id}>Выбрать класс</button></article>)}</div></div></section>
    <section class="test-drive section shell" id="test-drive"><div class="drive-panel reveal"><div class="drive-copy"><span class="kicker">ТЕСТ-ДРАЙВ ПРОФЕССИИ / 1 500 ₽</span><h2>Познакомьтесь с профессией<br/>и задачами</h2><p>За два дня вы пройдёте тест-драйв профессии, изучите решаемые задачи и выполните практический мини-квест. По результатам прохождения квеста вас ждёт личный созвон со мной для разбора результатов и построения индивидуального маршрута.</p><button class="button primary large" data-open-brief>Начать тест-драйв</button></div><ol class="drive-steps"><li><span>01</span><div><b>Получаете задание и полезные инструменты</b><p>Всё необходимое для знакомства с реальными задачами выбранной профессии.</p></div></li><li><span>02</span><div><b>Выполняете мини-квест</b><p>Создаёте небольшой, но настоящий инженерный результат.</p></div></li><li><span>03</span><div><b>Сдаёте и защищаете решение</b><p>Наставник видит результат и ход вашего мышления.</p></div></li><li><span>04</span><div><b>Приходите на личный разбор</b><p>30 минут обратной связи и построения индивидуального маршрута.</p></div></li></ol></div></section>
    <section class="mentor section shell reveal" id="mentor"><div class="mentor-photo"><img src="/photo_2025-11-18_12-50-03.jpg" width="680" height="800" loading="lazy" alt="Вадим Моисеенко — Профессор IT"/><span>PROFESSOR_IT / MENTOR</span></div><div class="mentor-copy"><span class="kicker">ВАШ НАСТАВНИК</span><h2>Вадим Моисеенко</h2><p class="mentor-role">Кандидат технических наук · 10+ лет в IT</p><p>Работаю с инфраструктурой, Linux, сетями, автоматизацией и безопасностью. Моя задача — научить видеть систему, проверять гипотезы и объяснять инженерные решения, постепенно передавая вам самостоятельность.</p><div class="mentor-facts"><span><b>1:1</b> индивидуальная работа</span><span><b>LIVE</b> разбор ваших решений</span><span><b>ETHICAL</b> только разрешённый контур</span></div><a class="text-link" href="/resume.html">Профессиональный путь <span>→</span></a></div></section>
    <section class="faq section shell reveal"><div class="section-head"><span class="kicker">БЕЗ МЕЛКОГО ШРИФТА</span><h2>Частые вопросы</h2></div><div class="faq-list">{faq.map(([question,answer],index)=><details><summary><span>{String(index+1).padStart(2,'0')}</span>{question}<i>+</i></summary><p>{answer}</p></details>)}</div></section>
    <section class="final-cta section shell reveal"><span class="kicker">ПЕРВЫЙ КВЕСТ</span><h2>Попробуйте профессию<br/>на практике</h2><p>Выполните реальную задачу, получите личную обратную связь и определите подходящий следующий шаг.</p><button class="button primary large" data-open-brief>Пройти тест-драйв <b>1 500 ₽</b></button><small>2 дня практики · личный разбор · решение о продолжении остаётся за вами</small></section>
  </main>
  <footer class="site-footer shell"><div class="brand"><span class="brand-mark">P</span><span>ПРОФЕССОР IT<small>ENGINEERING MENTORSHIP</small></span></div><div><a href="https://t.me/proffessor_it">Telegram</a><a href="https://github.com/alphaserver777">GitHub</a><a href="/business.html">Для бизнеса</a><a href="/privacy/">Конфиденциальность</a></div><small>© {new Date().getFullYear()} Профессор IT</small></footer>
  <Brief />
  <script src="../scripts/site.ts"></script>
</Base>
